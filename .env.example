# Copy to .env and fill in. .env is git-ignored - never commit real values.

# Required when DJANGO_DEBUG is false.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use local SQLite. For PostgreSQL:
# DATABASE_URL=postgres://cloudcost:<password>@localhost:5432/cloudcost
DATABASE_URL=

# Password for the local "demo" user created by `python manage.py seed_demo`.
DEMO_USER_PASSWORD=

# Optional. When empty, AI explanations are disabled and the app works without them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Docker Compose only ---
# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=
# Set to false when serving over plain http on localhost; leave true behind HTTPS.
DJANGO_SECURE_COOKIES=false
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Only for `--profile grafana`.
GRAFANA_ADMIN_PASSWORD=
